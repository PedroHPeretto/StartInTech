NODE_ENV="development"
FRONTEND_PORT="5173"
BACKEND_PORT="3000"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/startintech_db"

# Cloud Storage
GCS_PRIVATE_BUCKET="startintech-private-storage"

# JWT & Session
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="4h"

# Third-party APIs & AI
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENROUTER_API_KEY=
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Frontend Configuration
VITE_API_URL="http://localhost:3000"
VITE_GOOGLE_CLIENT_ID=

# Observability (Sentry)
VITE_SENTRY_DSN=
SENTRY_DSN=

# MCPs
CONTEXT7_API_KEY=
GITHUB_PAT=
GCP_APP_CREDENTIALS_JSON=